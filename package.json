{
  "name": "bandai-meeting-room-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:app",
    "install:all": "npm install --prefix app && npm install --prefix api",
    "dev:app": "npm run dev --prefix app",
    "dev:api": "npm run dev --prefix api",
    "build": "npm run build --prefix app",
    "lint": "npm run lint --prefix app",
    "test": "npm run test --prefix api && npm run test:e2e --prefix app",
    "test:api": "npm run test --prefix api",
    "test:app": "npm run test:e2e --prefix app"
  }
}
